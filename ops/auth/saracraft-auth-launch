#!/usr/bin/python3 -I
"""Attended, single-run SaraCraft authentication launcher (NOT installed).

Run only from a dedicated human-controlled TTY after separate authorization.
This invokes a separately sandboxed, transient auth-only systemd service.
Never use from Codex terminals, tmux logging, or shared PTY sessions.
"""
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys

BOT_USER = "saracraft-bot"
OPERATOR = "daniel"
OBSERVE_UNIT = "saracraft-bot.service"
AUTH_UNIT = "saracraft-auth-once.service"
CONTROL_INHIBIT = Path("/var/lib/saracraft-control/inhibit")
RELEASE_CURRENT = Path("/opt/saracraft/releases/current")
RELEASE_BASE = Path("/opt/saracraft/releases")
BOT_AUTH = Path("/var/lib/saracraft-bot/auth")
BOT_CACHE = BOT_AUTH / "cache"
BOT_RECEIPT = BOT_AUTH / ".provision-complete"
CACHE_NAME = re.compile(r"[a-f0-9]{6}_(?:msal|live|sisu|xbl|bed|mca|mcs|pfb)-cache\\.json")
NODE = Path("/opt/saracraft/runtimes/node-v22.23.5-linux-x64/bin/node")
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
TIMEOUT = 560
CLEAN_ENV = ("PATH=/usr/bin:/bin", "HOME=/nonexistent", "LANG=C")


def check_private_dir(path, uid):
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or             (info.st_mode & 0o077) or (info.st_mode & 0o6000):
        raise RuntimeError("Private authentication directory is unsafe")


def check_root_path(path, *, kind="directory", exact_mode=None):
    info = path.lstat()
    is_type = stat.S_ISDIR(info.st_mode) if kind == "directory" else stat.S_ISREG(info.st_mode)
    if not is_type or info.st_uid != 0 or info.st_gid != 0 or             (info.st_mode & 0o022) or (info.st_mode & 0o6000) or             (exact_mode is not None and stat.S_IMODE(info.st_mode) != exact_mode):
        raise RuntimeError("Trusted authentication installation path is unsafe")


def audit_trusted_tree(root, *, owner_uid=0, owner_gid=0, check_ancestors=True):
    """Fail closed on mutable, linked, foreign-owned or special executable inputs.

    This metadata audit is deliberately implemented in the trusted launcher,
    not imported from the release under inspection. It does not seal the tree:
    root-controlled custody must remain intact until the service exits.
    """
    root = root.absolute()
    paths = [root, *root.parents] if check_ancestors else [root]
    for path in paths:
        info = path.lstat()
        if (not stat.S_ISDIR(info.st_mode) or
                info.st_uid != owner_uid or info.st_gid != owner_gid or
                info.st_mode & 0o6022):
            raise RuntimeError("Trusted executable ancestor is unsafe")
    for directory, dirs, files in os.walk(root, topdown=True, followlinks=False):
        for name in [*dirs, *files]:
            path = Path(directory) / name
            info = path.lstat()
            if (not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)) or
                    info.st_uid != owner_uid or info.st_gid != owner_gid or
                    info.st_mode & 0o6022 or
                    (stat.S_ISREG(info.st_mode) and info.st_nlink != 1)):
                raise RuntimeError("Trusted executable tree contains unsafe entries")
        # os.walk does not follow directory symlinks, but they must be rejected.
    return True


def fixed_release():
    check_root_path(RELEASE_BASE)
    link = RELEASE_CURRENT.lstat()
    if not stat.S_ISLNK(link.st_mode) or link.st_uid != 0:
        raise RuntimeError("Approved release selector is unsafe")
    target = RELEASE_CURRENT.resolve(strict=True)
    if target.parent != RELEASE_BASE or not re.fullmatch(r"[0-9a-f]{40}", target.name):
        raise RuntimeError("Approved release selector is unexpected")
    audit_trusted_tree(target)
    audit_trusted_tree(NODE.parent.parent)
    # No dynamic caller-specified paths, and no trailing shell arguments.
    gate = target / "APPROVED-RELEASE"
    check_root_path(gate, kind="file")
    entry = target / "controller" / "connection" / "provision-auth.js"
    check_root_path(entry, kind="file")
    check_root_path(NODE, kind="file")
    return entry


def unit_status(unit):
    result = subprocess.run(
        [SYSTEMCTL, "show", unit, "--property=LoadState,ActiveState,MainPID", "--no-pager"],
        capture_output=True, text=True, timeout=12,
        env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"}, check=False,
    )
    if result.returncode:
        raise RuntimeError("Unable to verify service state")
    props = {}
    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key in {"LoadState", "ActiveState", "MainPID"}:
            if key in props:
                raise RuntimeError("Duplicate service state")
            props[key] = value
    if set(props) != {"LoadState", "ActiveState", "MainPID"} or             not props["MainPID"].isdigit():
        raise RuntimeError("Missing or invalid service status")
    return props


def preflight():
    if os.geteuid() != 0 or os.environ.get("SUDO_USER") != OPERATOR or             not os.isatty(0) or not os.isatty(1):
        raise RuntimeError("Dedicated attended sudo session required")
    with open("/dev/tty", "rb", buffering=0) as tty:
        if not os.isatty(tty.fileno()):
            raise RuntimeError("Private terminal unavailable")
    check_root_path(CONTROL_INHIBIT, kind="file", exact_mode=0o600)
    try:
        bot = pwd.getpwnam(BOT_USER)
    except KeyError as exc:
        raise RuntimeError("Authentication account unavailable") from exc
    check_private_dir(BOT_AUTH, bot.pw_uid)
    check_private_dir(BOT_CACHE, bot.pw_uid)
    if any(BOT_CACHE.iterdir()) or os.path.lexists(BOT_AUTH / ".provision.lock") or os.path.lexists(BOT_RECEIPT):
        raise RuntimeError("Authentication state needs private recovery")
    observe = unit_status(OBSERVE_UNIT)
    if observe["ActiveState"] != "inactive" or observe["MainPID"] != "0":
        raise RuntimeError("Observation service is not stopped")
    auth = unit_status(AUTH_UNIT)
    if auth["LoadState"] not in {"not-found", "loaded"} or             auth["ActiveState"] != "inactive" or auth["MainPID"] != "0":
        raise RuntimeError("Authentication session already active")
    return fixed_release()


def verify_completion():
    """Attest completed, private cache commit without reading credential bytes.

    systemd-run --wait can exit zero after SIGINT kills the service; its exit
    status alone is NOT an authentication result. The approved bot entrypoint
    creates a zero-byte receipt only after successful provisioning and lock
    release. The receipt is mandatory but does not protect against a trusted
    administrator or an attacker with bot-user write privileges.
    """
    bot = pwd.getpwnam(BOT_USER)
    check_private_dir(BOT_AUTH, bot.pw_uid)
    check_private_dir(BOT_CACHE, bot.pw_uid)
    if os.path.lexists(BOT_AUTH / ".provision.lock"):
        raise RuntimeError("Authentication completion lock remains")
    receipt = BOT_RECEIPT.lstat()
    if (not stat.S_ISREG(receipt.st_mode) or
            receipt.st_uid != bot.pw_uid or receipt.st_gid != bot.pw_gid or
            stat.S_IMODE(receipt.st_mode) != 0o600 or
            receipt.st_nlink != 1 or receipt.st_size != 0):
        raise RuntimeError("Authentication completion receipt is unsafe")
    found = False
    with os.scandir(BOT_CACHE) as items:
        for item in items:
            info = item.stat(follow_symlinks=False)
            if (not CACHE_NAME.fullmatch(item.name) or
                    not stat.S_ISREG(info.st_mode) or
                    info.st_uid != bot.pw_uid or info.st_gid != bot.pw_gid or
                    stat.S_IMODE(info.st_mode) != 0o600 or
                    info.st_nlink != 1):
                raise RuntimeError("Authentication completion cache is unsafe")
            found = True
    if not found:
        raise RuntimeError("Authentication completion has no verified cache")
    auth = unit_status(AUTH_UNIT)
    if (auth["ActiveState"] != "inactive" or auth["MainPID"] != "0"):
        raise RuntimeError("Authentication service did not terminate cleanly")
    return True


def command(entry):
    # systemd-run's --pty attaches the attended human terminal. It does not
    # write the device-code exchange into a journal-backed stdout stream.
    # Do not supply user-provided unit properties, executable or arguments.
    return [
        SYSTEMD_RUN, "--system", "--unit=" + AUTH_UNIT.removesuffix(".service"),
        "--pty", "--wait", "--collect", "--service-type=exec",
        "--property=User=" + BOT_USER,
        "--property=Group=" + BOT_USER,
        "--property=WorkingDirectory=" + str(entry.parent),
        "--property=BindPaths=" + str(BOT_AUTH) + ":/auth",
        "--property=ReadWritePaths=" + str(BOT_AUTH),
        "--property=ProtectSystem=strict",
        "--property=ProtectHome=yes",
        "--property=PrivateTmp=yes",
        "--property=PrivateDevices=yes",
        "--property=NoNewPrivileges=yes",
        "--property=CapabilityBoundingSet=",
        "--property=AmbientCapabilities=",
        "--property=RestrictSUIDSGID=yes",
        "--property=ProtectKernelTunables=yes",
        "--property=ProtectKernelModules=yes",
        "--property=ProtectControlGroups=yes",
        "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6",
        "--property=InaccessiblePaths=/srv/saracraft /etc/saracraft /run/docker.sock",
        "--property=UMask=0077",
        "--property=LimitCORE=0",
        "--property=Restart=no",
        "--property=RuntimeMaxSec=540",
        "--property=TimeoutStopSec=5",
        "--property=KillMode=control-group",
        "--property=SendSIGKILL=yes",
        "--property=Environment=PATH=/usr/bin:/bin",
        "--property=Environment=HOME=/nonexistent",
        "--property=Environment=LANG=C",
        "--",
        "/usr/bin/env", "-i", *CLEAN_ENV, str(NODE), str(entry),
    ]


def main(argv):
    if argv:
        return 2
    try:
        entry = preflight()
        result = subprocess.run(
            command(entry), env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"},
            stdin=None, stdout=None, stderr=None, timeout=TIMEOUT,
            check=False,
        )
        # No contents of PTY output or upstream exception reach this launcher.
        if result.returncode:
            raise RuntimeError("Attended authentication did not complete")
        verify_completion()
        return 0
    except KeyboardInterrupt:
        print("SaraCraft authentication interrupted; keep inhibit active.", file=sys.stderr)
        return 130
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired):
        print("SaraCraft authentication launcher failed; keep inhibit active.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
