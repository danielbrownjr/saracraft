#!/usr/bin/python3 -I
"""Root-installed allowlisted SaraCraft control backend; never runs arbitrary arguments.

This file must be owned by root and not writable by the developer or bot.
The service and its root-controlled release must be installed separately.
"""
import fcntl
import pwd
import stat
import json
import os
from pathlib import Path
import re
import subprocess
import sys

UNIT = "saracraft-bot.service"
SYSTEMCTL = "/usr/bin/systemctl"
PRIVATE_LOG = Path("/var/log/saracraft-bot/verification.jsonl")
PRIVATE_LOG_DIR = PRIVATE_LOG.parent
BOT_USER = "saracraft-bot"
MAX_LOG_BYTES = 256 * 1024
CONTROL_DIR = Path("/var/lib/saracraft-control")
LOCK = CONTROL_DIR / "operations.lock"
INHIBIT = CONTROL_DIR / "inhibit"
ALLOWED = {"start-observe", "status", "stop", "logs", "estop", "clear-inhibit"}
SAFE_EVENT = {
    "authenticating": set(),
    "authorization_required": set(),
    "failed": {"category"},
    "identity_verified": set(),
    "connecting": {"attempt"},
    "login": set(),
    "spawn": set(),
    "world_received": set(),
    "player_presence": {"self"},
    "observation_ready": set(),
    "telemetry_sample": {"rawAirReceived", "airPacketCount", "airPacketAgeMs",
                         "chunkColumnsLoaded", "entityCount", "entitiesObserved",
                         "inWater", "blockVolumeInWater", "physicsWaterFlag",
                         "creeperDistanceBlocks", "verdict"},
    "heartbeat": {"spawned", "world", "presence"},
    "disconnected": set(),
    "reconnecting": {"attempt"},
}
CATEGORIES = {"authentication", "AUTH_REQUIRED", "authentication_timeout",
              "session_deadline", "chat_certificate_unavailable",
              "network", "disconnection", "allowlist", "version_mismatch",
              "movement_halt", "shutdown"}
SAFE_STATE = re.compile(r"^(inactive|active|activating|deactivating|failed|reloading)$")
SAFE_REASON = re.compile(r"^[a-z_]{1,48}$")

def run(args):
    return subprocess.run(args, text=True, capture_output=True, timeout=12, check=False,
                          env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"})

def unit_state():
    result = run([SYSTEMCTL, "show", UNIT, "--property=ActiveState", "--value"])
    state = result.stdout.strip()
    if result.returncode or not SAFE_STATE.fullmatch(state):
        raise RuntimeError("Unable to determine restricted bot service state")
    return state

STATUS_FIELDS = ("ActiveState", "Result", "ConditionResult", "ExecMainStatus")
STATUS_VALUES = {
    "ActiveState": re.compile(r"^(inactive|active|activating|deactivating|failed|reloading)$"),
    "Result": re.compile(r"^(success|exit-code|signal|core-dump|timeout|watchdog|start-limit-hit|resources|protocol|oom-kill|condition|assert|dependency|clean|skip|)$"),
    "ConditionResult": re.compile(r"^(yes|no|)$"),
    "ExecMainStatus": re.compile(r"^[0-9]{0,5}$"),
}

def unit_details():
    # Fixed properties only; do not pass through arbitrary systemctl output.
    command = [SYSTEMCTL, "show", UNIT, "--property=" + ",".join(STATUS_FIELDS), "--no-pager"]
    result = run(command)
    if result.returncode:
        raise RuntimeError("Unable to determine restricted bot unit result")
    entries = {}
    for line in result.stdout.splitlines():
        if "=" not in line:
            continue
        name, value = line.split("=", 1)
        if name in STATUS_VALUES and STATUS_VALUES[name].fullmatch(value):
            if name in entries:
                raise RuntimeError("Duplicate unit status property")
            entries[name] = value
    if set(entries) != set(STATUS_FIELDS):
        raise RuntimeError("Missing or invalid unit status properties")
    return {name: entries[name] for name in STATUS_FIELDS}

def sanitize(entry):
    """Never forward raw journal text, unrecognized events or extra keys."""
    if not isinstance(entry, dict) or set(entry) - ({"time", "run", "event"} | set(SAFE_EVENT.get(entry.get("event"), ()))):
        return None
    event = entry.get("event")
    if event not in SAFE_EVENT or not isinstance(entry.get("time"), str) or not isinstance(entry.get("run"), str):
        return None
    if not re.fullmatch(r"\d{4}-\d\d-\d\dT[\d:.]+Z", entry["time"]):
        return None
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", entry["run"]):
        return None
    result = {"time": entry["time"], "event": event}
    for name in SAFE_EVENT[event]:
        if name not in entry:
            continue
        value = entry[name]
        if name == "category":
            if value not in CATEGORIES: return None
        elif name == "physicsWaterFlag":
            if value != "unavailable_physics_disabled": return None
        elif name == "verdict":
            if value not in ("UNKNOWN_STATE", "STATE_UNAVAILABLE"): return None
        elif name in ("rawAirReceived", "entitiesObserved", "self", "spawned", "world", "presence"):
            if type(value) is not bool: return None
        elif name in ("inWater", "blockVolumeInWater"):
            if value is not None and type(value) is not bool: return None
        elif name in ("attempt", "airPacketCount", "airPacketAgeMs", "chunkColumnsLoaded",
                      "entityCount", "creeperDistanceBlocks"):
            if value is not None and (type(value) is not int or not 0 <= value <= 1_000_000):
                return None
        else:
            return None
        result[name] = value
    return result

def read_private_log_lines():
    # Root-only fixed-path reader. Never fall back to journald or caller paths.
    try:
        bot_uid = pwd.getpwnam(BOT_USER).pw_uid
    except KeyError as error:
        raise RuntimeError("Bot account missing") from error
    directory_fd = os.open(PRIVATE_LOG_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        directory = os.fstat(directory_fd)
        if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != bot_uid or (directory.st_mode & 0o077) != 0:
            raise RuntimeError('Private log directory ownership or permissions are unsafe')
        descriptor = os.open(PRIVATE_LOG.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory_fd)
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != bot_uid or info.st_nlink != 1 or (info.st_mode & 0o077) != 0:
                raise RuntimeError('Private log file ownership or permissions are unsafe')
            length = min(info.st_size, MAX_LOG_BYTES)
            start = max(0, info.st_size - length)
            os.lseek(descriptor, start, os.SEEK_SET)
            data = bytearray()
            while len(data) < length:
                chunk = os.read(descriptor, min(8192, length - len(data)))
                if not chunk:
                    break
                data.extend(chunk)
            if start:
                # Discard the initial fragment, retaining complete trailing lines.
                first_newline = data.find(b"\n")
                data = data[first_newline + 1:] if first_newline >= 0 else bytearray()
            return bytes(data).decode("utf-8", errors="replace").splitlines()
        finally:
            os.close(descriptor)
    finally:
        os.close(directory_fd)

def public_logs():
    entries = []
    for line in read_private_log_lines():
        if len(line) > 4096:
            continue
        try:
            safe = sanitize(json.loads(line))
        except (ValueError, TypeError, RecursionError):
            continue
        if safe is not None:
            entries.append(safe)
    for entry in entries[-100:]:
        print(json.dumps(entry, separators=(",", ":"), sort_keys=True))

def validate_control_directory():
    # The installation contract requires an existing root-owned 0700 directory.
    if not CONTROL_DIR.is_dir() or CONTROL_DIR.is_symlink():
        raise RuntimeError("Control directory is not installed safely")
    st = CONTROL_DIR.stat()
    if st.st_uid != 0 or (st.st_mode & 0o077) != 0:
        raise RuntimeError("Control directory permissions are unsafe")

def stop_now():
    # Stop must be independent of persistence, directory validation, and locks.
    # The no-block systemd stop job replaces a queued start job for this unit.
    result = run([SYSTEMCTL, "stop", "--no-block", UNIT])
    if result.returncode:
        raise RuntimeError("Restricted service stop request failed")

def emergency_stop():
    # Persistence is best effort, but termination is always attempted, even if
    # the control directory is missing, read-only or otherwise untrustworthy.
    inhibit_error = None
    try:
        validate_control_directory()
        try:
            descriptor = os.open(INHIBIT, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            if not INHIBIT.is_file() or INHIBIT.is_symlink():
                raise RuntimeError("Emergency inhibit path is unsafe")
        else:
            os.close(descriptor)
    except (OSError, RuntimeError) as error:
        inhibit_error = error
    stop_error = None
    try:
        stop_now()
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        stop_error = error
    # A successful systemctl --no-block call confirms only job acceptance,
    # not completed process termination or server-side disconnect.
    stop_requested = stop_error is None
    inhibit_present = inhibit_error is None
    if not (stop_requested and inhibit_present):
        print(
            "ESTOP PARTIAL: stop_request=" + ("ACCEPTED" if stop_requested else "FAILED")
            + " inhibit_file=" + ("PRESENT" if inhibit_present else "NOT_CONFIRMED"),
            file=sys.stderr,
        )
        if not stop_requested:
            print("ACTION: Verify and terminate the bot through separately authorized host administration.", file=sys.stderr)
        if not inhibit_present:
            print("WARNING: Future starts are NOT inhibited; do not restart until the inhibit is repaired and verified.", file=sys.stderr)
        return 1
    print("ESTOP ACCEPTED: stop_request=ACCEPTED inhibit_file=PRESENT (termination not yet verified)")
    return 0

def control(operation):
    if operation == "stop":
        stop_now()
        print("Accepted: stop (stop requested)")
        return 0
    if operation == "estop":
        return emergency_stop()
    # Read-only operations never wait on the start/clear lock.
    if operation == "status":
        validate_control_directory()
        details = unit_details()
        print(json.dumps({"state": details["ActiveState"],
                          "result": details["Result"],
                          "condition_result": details["ConditionResult"],
                          "exec_main_status": int(details["ExecMainStatus"]) if details["ExecMainStatus"] else None,
                          "emergency_inhibit": INHIBIT.exists()}, sort_keys=True))
        return 0
    if operation == "logs":
        public_logs()
        return 0
    # Only start and privileged inhibit clearance require serialization.
    validate_control_directory()
    descriptor = os.open(LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        if operation == "start-observe":
            if INHIBIT.exists():
                raise RuntimeError("Emergency inhibit active; privileged clearance required")
            if unit_state() not in ("inactive", "failed"):
                raise RuntimeError("SaraCraft already running or starting")
            result = run([SYSTEMCTL, "start", "--no-block", UNIT])
            if result.returncode:
                raise RuntimeError("Restricted service start request failed")
            print("Accepted: start-observe (start requested; not a connection confirmation)")
            return 0
        if operation == "clear-inhibit":
            # Absent from operator sudoers; only explicitly authorized root admin.
            if unit_state() not in ("inactive", "failed"):
                raise RuntimeError("Stop service before clearing inhibit")
            INHIBIT.unlink(missing_ok=True)
            print("Emergency inhibit cleared by administrator")
            return 0
        raise RuntimeError("Unsupported operation")
    finally:
        os.close(descriptor)

def main(argv):
    if len(argv) != 1 or argv[0] not in ALLOWED:
        print("Unsupported restricted operation", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("Restricted helper requires root", file=sys.stderr)
        return 1
    try:
        return control(argv[0])
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print("SaraCraft control failed: " + str(error), file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
